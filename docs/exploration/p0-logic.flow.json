         "headers": {},
         "queryParams": {},
         "authType": "NONE",
         "authFields": {},
         "body_type": "none",
         "body": {},
         "failsafe": false
        },
        "propertySettings": {
         "method": {
          "type": "MANUAL"
         },
         "url": {
          "type": "MANUAL"
         },
         "headers": {
          "type": "MANUAL"
         },
         "queryParams": {
          "type": "MANUAL"
         },
         "authType": {
          "type": "MANUAL"
         },
         "authFields": {
          "type": "MANUAL"
         },
         "body_type": {
          "type": "MANUAL"
         },
         "body": {
          "type": "MANUAL"
         },
         "failsafe": {
          "type": "MANUAL"
         }
        },
        "errorHandlingOptions": {
         "retryOnFailure": {
          "value": false
         },
         "continueOnFailure": {
          "value": false
         }
        }
       },
       "nextAction": {
        "name": "step_7",
        "type": "PIECE",
        "valid": true,
        "displayName": "Reply",
        "skip": false,
        "settings": {
         "pieceName": "@activepieces/piece-webhook",
         "pieceVersion": "0.1.42",
         "pieceType": "OFFICIAL",
         "packageType": "REGISTRY",
         "actionName": "return_response",
         "input": {
          "responseType": "json",
          "respond": "stop",
          "fields": {
           "status": 200,
           "headers": {},
           "body": {
            "total": "{{step_1['total']}}",
            "branch": "done",
            "http": "{{step_6['status']}}"
           }
          }
         },
         "propertySettings": {
          "responseType": {
           "type": "MANUAL"
          },
          "respond": {
           "type": "MANUAL"
          },
          "fields": {
           "type": "MANUAL"
          }
         },
         "errorHandlingOptions": {
          "retryOnFailure": {
           "value": false
          },
          "continueOnFailure": {
           "value": false
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}